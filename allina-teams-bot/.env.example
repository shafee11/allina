# Microsoft Teams / Bot Registration
CLIENT_ID=your-microsoft-app-client-id
CLIENT_SECRET=your-microsoft-app-client-secret
TENANT_ID=your-microsoft-tenant-id

# AWS Configuration (uses default AWS profile or explicit named profile)
AWS_PROFILE=default
AWS_REGION=us-east-1

# ALLINA A7 Target EC2 Configuration
ALLINA_EC2_INSTANCE_ID=i-0123456789abcdef0
# Target Environment: 'local' (local PC directory), 'mock' (synthetic dry run), 'aws', or 'azure'
ALLINA_TARGET_MODE=local
ALLINA_ALLOWED_LOG_DIR=d:/allina_project/local-test-logs
ALLINA_ALLOWED_LOG_PREFIX=allina-poc-
ALLINA_ALLOWED_LOG_EXTENSION=.log
ALLINA_MIN_FILE_AGE_HOURS=24
ALLINA_MAX_CLEANUP_FILES=50
ALLINA_MAX_CLEANUP_BYTES=10737418240

# Governance & Approver Allowlist (comma-separated Entra / Azure AD Object IDs)
ALLINA_TENANT_ID=your-microsoft-tenant-id
ALLINA_APPROVER_AAD_IDS=00000000-0000-0000-0000-000000000000,11111111-1111-1111-1111-111111111111
# Set to true to allow self-approval for solo testing / demo while keeping it flexible for others
ALLINA_ALLOW_SELF_APPROVAL_FOR_DEMO=false

# Safety & Execution Controls (Fail-Closed Defaults)
ALLINA_DRY_RUN=true
ALLINA_ENABLE_REAL_EXECUTION=false
ALLINA_BACKUP_CONFIRMED=false

# Azure VM Target Configuration
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
AZURE_SUBSCRIPTION_ID=your-azure-subscription-id
AZURE_RESOURCE_GROUP=your-azure-resource-group
AZURE_VM_NAME=your-azure-vm-name

# Persistence & Storage
ALLINA_DB_PATH=data/allina_poc.db
ALLINA_REQUEST_EXPIRY_MINUTES=30

